# Local dev: Vite proxies /api → localhost:8000 (see vite.config.js)
VITE_API_URL=/api

# Production: your Render backend URL (no trailing slash)
# VITE_API_URL=https://aria-api.onrender.com

# Stable Vercel URL for Composio OAuth callbacks (no trailing slash)
# VITE_APP_URL=https://aria-frontend.vercel.app

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
